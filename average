import sys

# 引数がない場合
if len(sys.argv) == 1:
    print("Usage: average number1 number2 ...", file=sys.stderr)
    print("Error: No numbers provided.", file=sys.stderr)
    sys.exit(1)

nums = []

for a in sys.argv[1:]:
    try:
        nums.append(float(a))
    except ValueError:
        print(f"Error: '{a}' is not a valid number.", file=sys.stderr)
        sys.exit(1)

# 平均を計算
avg = sum(nums) / len(nums)

# 標準出力へ結果を出す（OK）
print(avg)
