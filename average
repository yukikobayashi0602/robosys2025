import sys

# 引数なし
if len(sys.argv) == 1:
    print("Usage: avg.py number1 number2 ...")
    print("Error: No numbers provided.")
    sys.exit(1)

total = 0.0
count = 0

for arg in sys.argv[1:]:
    try:
        total += float(arg)
        count += 1
    except ValueError:
        print(f"Error: '{arg}' is not a valid number.")
        sys.exit(1)

# 平均を計算
print(total / count)
