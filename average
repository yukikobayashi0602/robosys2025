import sys

# 引数が無い場合
if len(sys.argv) == 1:
    print("Usage: avg.py number1 number2 ...", file=sys.stderr)
    print("Error: No numbers provided.", file=sys.stderr)
    sys.exit(1)

nums = []
for n in sys.argv[1:]:
    try:
        nums.append(float(n))
    except ValueError:
        print(f"Error: '{n}' is not a valid number.", file=sys.stderr)
        sys.exit(1)

avg = sum(nums) / len(nums)
print(avg)
